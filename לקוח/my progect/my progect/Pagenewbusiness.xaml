<Page x:Class="my_progect.Pagenewbusiness"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:my_progect"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Title="Pagenewbusiness">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height=" 0.5*"></RowDefinition>
            <RowDefinition Height=" *"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition  Height="*"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height=" *" ></RowDefinition>
            <RowDefinition Height=" *"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="פרטי עסק"  Grid.ColumnSpan="2" Grid.Row="0" Foreground="#FFFFFEFE" FontSize="50" HorizontalAlignment="Center" FontFamily="Arial" ></TextBlock>
        <TextBlock Text="שם עסק" Grid.Column="1" VerticalAlignment="Center" Grid.Row="1" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Text="ת.ז בעל עסק" Grid.Column="1" VerticalAlignment="Center"  Grid.Row="2" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Text="קטגוריה"  Grid.Column="1" VerticalAlignment="Center" Grid.Row="3" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Text="תאור" Grid.Column="1" VerticalAlignment="Center" Grid.Row="4" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Text="תמונות" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center" Grid.Row="5" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>

        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="1" Width="300" Margin="20">
            <TextBox x:Name="name"  Text="{Binding Name}" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" />
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="2" Width="300"  Margin="20">
            <TextBox x:Name="sellerid"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1" ></TextBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="3" Width="300"  Margin="20">
            <ComboBox Name="cmbcategory" DisplayMemberPath="Name" SelectedItem="{Binding Categoriesid}" Width="200"  ></ComboBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="4" Margin="20" Width="300">
            <TextBox x:Name="description" Text="{Binding Description}" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1" Margin="0,0,0,31" />
        </Border>
        <Border Padding="5" Visibility="Collapsed" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="5" Width="300" Margin="20"  >
            <TextBox x:Name="picture1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1"  ></TextBox>
        </Border>
        <Border Padding="5" Visibility="Collapsed" CornerRadius="10" Background="White" Grid.Column="1" Grid.Row="5" Width="300" Margin="20"  >
            <TextBox x:Name="picture2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1"  ></TextBox>
        </Border>
        <Border Padding="5" Visibility="Collapsed" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="7" Width="300" Margin="20"  >
            <TextBox x:Name="picture3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1"  ></TextBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.ColumnSpan="2" Grid.Row="7"  Width="400" Height="70">
            <Button Background="Transparent" BorderThickness="0" Content=" הבא  " Foreground="Black"  FontSize="30" FontWeight="Bold" Height="70" FontFamily="Arial" BorderBrush="#FF060606" Margin="-5,0,-5,-10" VerticalAlignment="Bottom" Click="Button_Click"      />
        </Border>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" >
            <Image x:Name="img1"  Width="200" Height="200"  ></Image>
            <Button x:Name="btn1" Content="..." Width="60" Height="60" Margin="3" Click="btn1_Click"></Button>
            <Image x:Name="img2" Width="200" Height="200" Margin="3"></Image>
            <Button x:Name="btn2" Content="..." Width="60" Height="60" Margin="3" Click="btn2_Click"></Button>
            <Image x:Name="img3"  Width="200" Height="200" Margin="3"></Image>
            <Button x:Name="btn3" Content="..." Width="60" Height="60" Margin="3" Click="btn3_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
