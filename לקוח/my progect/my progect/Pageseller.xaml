<Page x:Class="my_progect.Pageseller"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:my_progect"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Pageseller">

    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBox x:Name="b10" Width="200"  Text="{Binding Id}"  Height="40"></TextBox>
                <TextBlock Text=":תעודת זהות" Width="300" HorizontalAlignment="Center" FontSize="30"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBox x:Name="b11" Width="200"    Height="40"></TextBox>
                <TextBlock Text=":שם פרטי" Width="300" HorizontalAlignment="Center" FontSize="30"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBox x:Name="b22" Width="200" Text="{Binding Lastname}"  Height="40"></TextBox>
                <TextBlock Text=":שם משפחה" Width="300" HorizontalAlignment="Center" FontSize="30"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBox x:Name="b33" Width="200" Text="{Binding Phone}"  Height="40"></TextBox>
                <TextBlock Text=":פלפון" Width="300" HorizontalAlignment="Center" FontSize="30"></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBox x:Name="b44" Width="200" Text="{Binding Code}"  Height="40"></TextBox>
                <TextBlock Text=":קוד" Width="300" HorizontalAlignment="Center" FontSize="30"></TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <ComboBox Name="cmbcity" DisplayMemberPath="Name" SelectedItem="{Binding C1}" Width="200"   ></ComboBox>
                <TextBlock Text=": עיר" Width="300" HorizontalAlignment="Center" FontSize="30"></TextBlock>
            </StackPanel>


            <Button Content="ok" Width="200" Height="40" FontSize="30" Click="Button_Click" ></Button>

        </StackPanel>
    </Grid>
</Page>
