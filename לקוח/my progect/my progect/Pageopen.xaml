<Page x:Class="my_progect.Pageopen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:my_progect"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Pageopen">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/צילום מסך 2024-02-14 001620.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="6*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
       
        <TextBlock Text="פורטל אירועים" Grid.Row="1" Grid.Column="1" FontSize="150" Foreground="Beige" FontFamily="Toliton FM" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <Border Padding="5" CornerRadius="10" Background="Transparent">
            <Button  HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="0" Content="התחברות" Foreground="Beige"  FontSize="30" FontWeight="Bold" Width="140" Height="70" FontFamily="Arial" Click="Button_Click_1"   ></Button>
        </Border>
        
        
       
        
      
       
      
      
    </Grid>
</Page>
