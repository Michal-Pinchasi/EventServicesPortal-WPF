<Page x:Class="my_progect.PageBusinessSeller"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:my_progect"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageBusinessSeller">

    <Grid>
       
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
       

        <ListView Grid.Row="0" Name="lst3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="קוד עסק" Width="100" DisplayMemberBinding="{Binding Id}"></GridViewColumn>
                    <GridViewColumn Header="קוד קטגוריה" Width="100" DisplayMemberBinding="{Binding Categoriesid.Name}"></GridViewColumn>
                    <GridViewColumn Header="שם" Width="100" DisplayMemberBinding="{Binding Name}"></GridViewColumn>
                    <GridViewColumn Header="קוד מוכר" Width="100" DisplayMemberBinding="{Binding Sellerid.Id}"></GridViewColumn>
                    <GridViewColumn Header="תאור" Width="100" DisplayMemberBinding="{Binding Description}"></GridViewColumn>
                    <GridViewColumn Header="תמונה1" Width="100" DisplayMemberBinding="{Binding Image1}"></GridViewColumn>
                    <GridViewColumn Header="תמונה2" Width="100" DisplayMemberBinding="{Binding Image2}"></GridViewColumn>
                    <GridViewColumn Header="תמונה3" Width="100" DisplayMemberBinding="{Binding Image3}"></GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
    
     


        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical">
            <Button  FontSize="20"  Content="הוסף עסק" Foreground="White" Background="Black" Height="65" Click="Button_Click_2"   ></Button>
            <Button  FontSize="20" Content="עדכן עסק" Foreground="White" Background="Black"  Height="65" Click="Button_Click"    ></Button>
           

        </StackPanel>
    </Grid>
</Page>
