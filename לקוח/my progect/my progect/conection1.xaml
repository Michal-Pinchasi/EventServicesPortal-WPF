<Page x:Class="my_progect.conection1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:my_progect"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="700"
      Title="conection1">

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="70"></RowDefinition>

            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="9" Grid.ColumnSpan="2" Width="300" Height="100">
            <Button  HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch" BorderThickness="0" Content="התחברות" Foreground="Black"  FontSize="30" FontWeight="Bold" Width="140" Height="70" FontFamily="Arial" BorderBrush="#FF060606" Click="Button_Click_3"    ></Button>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="0" Width="120" Height="70" HorizontalAlignment="Left">
            <Button Background="Transparent" BorderThickness="0" Content="חזור" Foreground="Black"  FontSize="30" FontWeight="Bold" Width="140" FontFamily="Arial" Margin="0,0,-30,-10" Click="Button_Click"    />
        </Border>
        <TextBlock Text="התחברות כלקוח" Grid.Column="1" Grid.Row="1" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <TextBlock Text="התחברות כבעל עסק" Grid.Column="0" Grid.Row="1" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <Rectangle HorizontalAlignment="Left" Height="806" Grid.RowSpan="6" Stroke="#FFFDFDFD" VerticalAlignment="Top" Width="1" Margin="10,-14,0,0" Grid.Column="1"/>
        <TextBlock Text="טלפון" Grid.Column="1" Grid.Row="2" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"></TextBlock>
        <TextBlock Text="קוד" Grid.Column="1" Grid.Row="5" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" ></TextBlock>
        <TextBlock Text="טלפון" Grid.Column="0" Grid.Row="2" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"></TextBlock>
        <TextBlock Text="קוד" Grid.Column="0" Grid.Row="5" Foreground="#FFFFFEFE" FontSize="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"></TextBlock>

        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="1" Grid.Row="3" Width="300" Height="100">
            <TextBox x:Name="foncos"  HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="1" ></TextBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="1" Grid.Row="6"  Width="300" Height="100">
            <TextBox x:Name="codcos" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="5" Grid.Column="1" ></TextBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="3"  Width="300" Height="100">
            <TextBox x:Name="fonsel"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="3" Grid.Column="0" ></TextBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="White" Grid.Column="0" Grid.Row="6"  Width="300" Height="100">
            <TextBox x:Name="codsel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="White" BorderThickness="0" Grid.Row="5" Grid.Column="0" ></TextBox>
        </Border>
        <Border Padding="5" CornerRadius="10" Background="transparent" Grid.Column="0" Grid.Row="8"  Width="400" Height="70">
            <Button Background="Transparent" BorderThickness="0" Content="חדש באתר? לפתיחת עסק " Foreground="White"  FontSize="30" FontWeight="Bold" Height="70" FontFamily="Arial" BorderBrush="#FF060606" Margin="5,0,5,-10" Click="Button_Click_2"    />
        </Border>
        <Border Padding="5" CornerRadius="10" Background="Transparent" Grid.Column="1" Grid.Row="8"  Width="400" Height="70">
            <Button Background="Transparent" BorderThickness="0" Content=" עוד לא נרשמת? לפתיחת חשבון " Foreground="White"  FontSize="30" FontWeight="Bold" Height="70" FontFamily="Arial" BorderBrush="#FF060606" Margin="-5,0,-5,-10" Click="Button_Click_1"    />
        </Border>
        <TextBlock x:Name="textcodseler" Grid.Row="7" Grid.Column="0" Foreground="Red" Text="הקוד אינו תקין" HorizontalAlignment="Center" FontSize="20" Visibility="Hidden" ></TextBlock>
        <TextBlock x:Name="textfhonseler" Grid.Row="4" Grid.Column="0" Foreground="Red" Text="אחד מן הפרטים שגויים המוכר אינו נמצא" HorizontalAlignment="Center" FontSize="20" Visibility="Hidden" ></TextBlock>
        <TextBlock x:Name="textcodcos" Grid.Row="7" Grid.Column="1" Foreground="Red" Text="הקוד אינו תקין" HorizontalAlignment="Center" FontSize="20" Visibility="Hidden" ></TextBlock>
        <TextBlock x:Name="textfhoncos" Grid.Row="4" Grid.Column="1" Foreground="Red" Text="אחד מן הפרטים שגויים הלקוח אינו נמצא" HorizontalAlignment="Center" FontSize="20" Visibility="Hidden" ></TextBlock>
    </Grid>
</Page>
