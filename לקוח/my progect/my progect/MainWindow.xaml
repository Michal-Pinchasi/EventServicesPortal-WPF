<Window x:Class="my_progect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:HamburgerMenu="clr-namespace:HamburgerMenu;assembly=HamburgerMenu"
        xmlns:local="clr-namespace:my_progect"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <HamburgerMenu:HamburgerMenu x:Name="myMenu" Grid.Column="0" Background="Black" MenuItemForeground="Black" Visibility="Collapsed" >
            <HamburgerMenu:HamburgerMenuItem x:Name="Dummy"  Text="Dummy" Visibility="Collapsed"></HamburgerMenu:HamburgerMenuItem>
            <HamburgerMenu:HamburgerMenuItem x:Name="Home" Foreground="White" Icon="Assets/home.png" Text="Home" Selected="Home_Selected"  ></HamburgerMenu:HamburgerMenuItem>
            <HamburgerMenu:HamburgerMenuItem x:Name="personal" Foreground="White"  Icon="Assets/person.png" Text="פרטים אשיים" Selected="personal_Selected" ></HamburgerMenu:HamburgerMenuItem>
            <HamburgerMenu:HamburgerMenuItem x:Name="business" Foreground="White"  Icon="Assets/business.png" Text="עסקים" Selected="business_Selected"  ></HamburgerMenu:HamburgerMenuItem>
            <HamburgerMenu:HamburgerMenuItem x:Name="chat" Foreground="White"  Icon="Assets/צאט.png" Text="צאטים" Selected="chat_Selected"  ></HamburgerMenu:HamburgerMenuItem> 
            <HamburgerMenu:HamburgerMenuItem x:Name="chatcos" Foreground="White"  Icon="Assets/צאט.png" Text="צאטים" Selected="chatcos_Selected"  ></HamburgerMenu:HamburgerMenuItem>
            <HamburgerMenu:HamburgerMenuItem x:Name="exit" Foreground="White"  Icon="Assets/יציאה.png" Text="יציאה" Selected="exit_Selected"   ></HamburgerMenu:HamburgerMenuItem>

        </HamburgerMenu:HamburgerMenu>


        <Frame Grid.Column="1" x:Name="frm" Source="Pageopen.xaml"></Frame>
    </Grid>
</Window>
